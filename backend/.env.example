# --- Développement ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Production (à remplir avant de passer DEBUG=False) ---
# Obligatoire dès que DEBUG=False. Générer avec :
#   python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Laisser vide pour utiliser SQLite (dev). Renseigner pour passer sur Postgres :
# DATABASE_URL=postgres://user:password@localhost:5432/montres_db
DATABASE_URL=

# Numéro WhatsApp, email, adresse : ils ne sont plus ici.
# Tout se règle dans l'admin Django → « Réglages du site ».

# --- Base de données (production) ---
# Vide = SQLite local. En ligne : la chaîne Postgres fournie par Neon.
DATABASE_URL=

# --- Photos (production) ---
# Vide = disque local. En ligne : la valeur « API Environment variable »
# affichée par Cloudinary. Sans elle, Django refuse de démarrer quand
# DEBUG=False — les photos ajoutées depuis l'admin disparaîtraient sinon au
# déploiement suivant.
CLOUDINARY_URL=
